# OpenAI API Configuration (Optional)
# Required for LLM-based features like answer generation and causal inference
# Option 1: Regular OpenAI API
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here

# Option 2: Azure OpenAI API
# USE_AZURE_OPENAI=false  # Set to true to use Azure OpenAI
# AZURE_OPENAI_API_KEY=your-azure-subscription-key-here
# AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4  # Your deployment name in Azure

# Model Configuration (Optional)
# DEFAULT_MODEL=gpt-4o-mini  # For regular OpenAI, or your Azure deployment name
# DEFAULT_EMBEDDING_MODEL=minilm

# Cache Configuration (Optional)
# CACHE_DIR=./cache
# LOG_LEVEL=INFO